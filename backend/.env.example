# Export these variables before starting Uvicorn; .env is not auto-loaded.
MARKETPULSE_DB_PATH=data/marketpulse.sqlite3
MARKETPULSE_VERSION=0.1.0
MARKETPULSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Streaming starts automatically unless explicitly disabled.
MARKETPULSE_FEED_ENABLED=true
MARKETPULSE_SYMBOL=AAPL
# Default UI/API interval; all 1m, 5m and 15m buckets are constructed live.
MARKETPULSE_CANDLE_INTERVAL=1m
# Conservative provenance default; do not enable merely because a socket connects.
MARKETPULSE_REALTIME_CONFIRMED=false
MARKETPULSE_FRESH_SECONDS=15
MARKETPULSE_STALE_SECONDS=120
MARKETPULSE_MAX_FUTURE_SECONDS=5
MARKETPULSE_CONNECT_TIMEOUT_SECONDS=15
MARKETPULSE_CLOSE_TIMEOUT_SECONDS=5
MARKETPULSE_RECONNECT_BASE_SECONDS=1
MARKETPULSE_RECONNECT_MAX_SECONDS=30
MARKETPULSE_MAX_RECONNECT_ATTEMPTS=5
MARKETPULSE_COMPLETION_CHECK_SECONDS=1
